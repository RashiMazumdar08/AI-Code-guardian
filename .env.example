# -- NVIDIA Nemotron 3 Ultra (required for the AI layer) ------------------
# Get a key at https://build.nvidia.com/ -> API Keys
NVIDIA_API_KEY="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"
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# -- Generation parameters ----------------------------------------------
LLM_TEMPERATURE=1.0
LLM_MAX_TOKENS=16384
LLM_TOP_P=0.95

# -- Transport / reliability --------------------------------------------
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=2.0

# -- Observability -------------------------------------------------------
# Prompts can contain source code; logging them is OFF by default.
LLM_LOG_PROMPTS=false

# -- Nemotron Ultra reasoning (chain-of-thought) -------------------------
LLM_ENABLE_THINKING=true
LLM_REASONING_BUDGET=16384

# -- Local embeddings (never sent to a remote API) -----------------------
ACG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
ACG_EMBED_DIM=384
ACG_EMBED_DEVICE=cpu
